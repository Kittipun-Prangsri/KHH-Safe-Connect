{
  "name": "khh-safe-connect-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel dev",
    "build": "pnpm --filter @khh/web build",
    "deploy": "rm -rf apps/web/.next/cache && wrangler pages deploy apps/web/.next --project-name khh-safe-connect",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "next": "^14.1.0",
    "typescript": "^5.0.0"
  }
}
